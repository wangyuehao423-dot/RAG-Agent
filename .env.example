# 本文件仅作「变量名参考」，Spring Boot 不会自动加载 .env。
# 请把下面两个 key 设置为系统环境变量（或 IDEA 运行配置）。

# 对话模型（DeepSeek）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 向量化模型（通义千问，DeepSeek 无 embedding 接口，需另开通，新用户有免费额度）
# 开通地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 数据库连接（默认与 docker-compose.yml 保持一致，本地开发无需修改）
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 可选：自定义 base-url / 模型名（不设则用 application.yml 默认值）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3