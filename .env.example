# ============================================================
# 模板文件：复制为 .env 后填入你自己的 key
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库。
# ============================================================
# 应用本身不读 .env —— 是 run.cmd / run.sh 读取它，
# 再以环境变量形式注入给进程。用 IDEA 启动时，请把这些变量
# 填进「运行配置 → 环境变量」。
#
# 密钥只从环境变量读取，配置文件里没有默认值；
# 忘记注入会直接启动失败（而不是拿占位符跑出 401）。

# 对话模型（DeepSeek）
DEEPSEEK_API_KEY=

# 向量化模型（通义千问百炼，DeepSeek 无 embedding 接口）
# 开通地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# ---- 以下可选，不填则用 application.yml 默认值 ----

# 数据库连接（默认与 docker-compose.yml 一致，本地开发无需修改）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=ragdb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# 自定义 base-url / 模型名
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
